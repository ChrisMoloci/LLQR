{
  "name": "@chrismoloci/qr-lib",
  "version": "0.0.1",
  "description": "One of the most customizable QR Code Generators",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "require": "./dist/types.cjs",
      "import": "./dist/types.mjs"
    },
    "./constants": {
      "require": "./dist/constants.cjs",
      "import": "./dist/constants.mjs"
    },
    "./api": {
      "require": "./dist/api.cjs",
      "import": "./dist/api.mjs"
    }
  },
  "scripts": {
    "dev": "tsup --watch --sourcemap --format cjs,esm --dts",
    "build": "tsup --format cjs,esm --dts",
    "test": "vitest run",
    "test:browser": "vitest --config=vitest.browser.config.ts run",
    "test:watch": "vitest",
    "test:browser:watch": "vitest --config=vitest.browser.config.ts"
  },
  "author": "chrismoloci",
  "license": "MIT",
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "vitest": "^4.0.17"
  }
}
